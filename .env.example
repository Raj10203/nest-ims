# Values for running the app / TypeORM CLI on the host against the docker-compose MySQL.
# Inside docker-compose, the app container gets its DB_* values from docker-compose.yml instead.
DB_HOST=localhost
DB_PORT=3308
DB_USER=user
DB_PASSWORD=password
DB_NAME=nest_ims
DB_SSL=false
# Optional: PEM file with the CA certificate(s) used to verify the server when DB_SSL=true
# DB_SSL_CA=/path/to/ca.pem
JWT_ACCESS_SECRET=replace-with-random-string-of-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-random-string-of-32-chars
JWT_REFRESH_EXPIRES_IN=7d
# RabbitMQ broker for background jobs (docker-compose: AMQP :5672, UI http://localhost:15672, login ims/ims).
# Production: use real credentials, amqps:// for TLS.
RABBITMQ_URL=amqp://ims:ims@localhost:5672
# docker-compose only: broker login (defaults ims / ims); keep RABBITMQ_URL in sync
# RABBITMQ_USER=ims
# RABBITMQ_PASSWORD=ims
# Optional: jobs the worker runs at once (default 5)
# WORKER_CONCURRENCY=5
# Worker (required) and API (optional, adds the mail check to GET /health). docker-compose Mailpit: SMTP :1025, inbox UI http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="IMS <no-reply@ims.local>"
# Optional, for a real SMTP provider
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_SECURE=true
# Azure Blob Storage for uploaded files (avatars). docker-compose runs the Azurite emulator on :10000;
# the key below is Azurite's published development key. Production: the storage account's connection string.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;"
AZURE_STORAGE_CONTAINER=avatars
# Optional: base URL written into stored blob URLs instead of the connection string's endpoint (e.g. a CDN)
# AZURE_STORAGE_PUBLIC_URL=http://localhost:10000/devstoreaccount1
# Optional: serve Swagger UI at /docs (JSON at /docs-json)
SWAGGER_ENABLED=true
# Optional: comma-separated browser origins allowed to call the API (no trailing slash); unset = no CORS
# CORS_ORIGINS=http://localhost:5173
# Optional: number of reverse proxies in front of the API, so rate limiting sees the client IP
# TRUST_PROXY=1
# development logs request and response bodies; anything else (production, or unset)
# logs metadata only. Secrets (password, tokens, otp...) are always masked.
NODE_ENV=development
# Optional, production only: 'true' also logs the request body and query of every request (never the response)
# LOG_REQUEST_BODY=true
# Optional: fatal | error | warn | info (default) | debug | trace | silent
# LOG_LEVEL=info
# Optional: also write logs to a daily-rotating file (base path; keeps 14 files)
# LOG_FILE=logs/app
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
SEED_SUPER_ADMIN_FIRST_NAME=Super
SEED_SUPER_ADMIN_LAST_NAME=Admin
