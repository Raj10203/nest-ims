{
  "name": "nest-ims",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:worker": "nest start --entryFile worker",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "start:worker:prod": "node dist/worker",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "migration": "typeorm migration:run -d dist/database/data-source.js",
    "i18n:types": "nestjs-i18n -p src/i18n -o src/generated/i18n.generated.ts",
    "i18n:check": "nestjs-i18n check -p src/i18n"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "@casl/ability": "^7.0.1",
    "@nestjs/cache-manager": "^12.0.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.2.0",
    "cache-manager": "^7.2.9",
    "helmet": "^8.3.0",
    "keyv": "^6.1.0",
    "mysql2": "^3.24.5",
    "nest-commander": "^3.21.0",
    "nestjs-i18n": "^10.8.5",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.1.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-roll": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
